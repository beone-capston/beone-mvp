# /opt/beone/demo/.env (chmod 600). 키 이름만 둔다. 값은 서버에서 채우고 출력하지 않는다.
# SMTP(SPRING_MAIL_*)·CODEF(CODEF_*·BEONE_CODEF_*) 키는 두지 않는다. demo는 가짜 메일·가짜 CODEF를 쓴다.

# 시연 전용 DB(운영·스테이징 값과 다르게). 비밀번호는 openssl rand -hex 24
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ghcr.io/beone-capston/beone-api@sha256:<digest>. 태그가 아니라 digest로 쓴다
BEONE_API_IMAGE=

# 서버에 이미 있는 nginx 이미지 태그(docker image ls로 확인, 추가 다운로드 방지)
BEONE_DEMO_NGINX_IMAGE=

# 백엔드 프로필. 비우면 demo. prod·member·staging은 넣지 않는다(기동 거부, 런북 6절)
BEONE_DEMO_PROFILES=
