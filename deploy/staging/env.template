# /opt/beone/staging/.env (chmod 600). 키 이름만 둔다. 값은 서버에서 Aside·사용자가 채우고 출력하지 않는다.
# CODEF_*·BEONE_CODEF_* 키는 아래 스테이징 CODEF 절의 플래그를 true로 켤 때만 둔다. 플래그가 없거나 false인데 키가 있으면
# deploy.sh가 배포를 거부한다(#275, docs/deployment/staging-codef.md).

# 스테이징 전용 DB(운영 값과 다르게). 비밀번호는 openssl rand -hex 24
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# deploy.sh가 실행할 때 ghcr.io/beone-capston/beone-api@<digest>로 덮어쓴다. 수동 명령용 마지막 배포 값
BEONE_API_IMAGE=

# 서버에 이미 있는 nginx 이미지 태그(docker image ls로 확인, 추가 다운로드 방지)
BEONE_STAGING_NGINX_IMAGE=

# 실메일(prod 프로필 필수, 결정 39-6). 앱 비밀번호는 비밀값
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
BEONE_MAIL_FROM=
# 스테이징 공개 HTTPS 주소(https://로 시작). 메일 링크가 이 주소를 쓴다
BEONE_MAIL_LINK_BASE_URL=

# 스테이징 한정 CODEF(#275, 2026-11-27 사용자 결정). 기본 인증 뒤 시연 전용. 켜고 끄는 절차는 docs/deployment/staging-codef.md.
# 켤 때만 아래 줄들의 주석을 풀고 값은 서버에서 사용자가 직접 넣는다(read -rs, 출력 금지). 끌 때는 플래그를 false로 바꾸거나
# 지우고 CODEF 키 줄을 모두 지운다. 켬 상태에서 아래 키 중 하나라도 없거나 비면 deploy.sh가 배포를 거부한다.
# 플래그 값은 true 또는 false만 쓴다(따옴표 없이).
# BEONE_STAGING_CODEF_ENABLED=
# CODEF_CLIENT_ID=
# CODEF_CLIENT_SECRET=
# CODEF_PUBLIC_KEY=
# BEONE_CODEF_CONNECTED_ID_KEY=
# BEONE_CODEF_APPROVAL_HMAC_KEY=
# 비밀 아님. https://sandbox.codef.io · https://development.codef.io · https://api.codef.io 중 하나
# BEONE_CODEF_PRODUCT_HOST=
# 호출 상한(비밀 아님). 권장: 10, 2026-11-26T00:00:00+09:00, 2026-12-10T00:00:00+09:00(시작 포함·끝 제외)
# BEONE_CODEF_BUDGET_PER_API=
# BEONE_CODEF_BUDGET_WINDOW_START=
# BEONE_CODEF_BUDGET_WINDOW_END=
