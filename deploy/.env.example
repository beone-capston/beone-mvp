# 배포용 환경 파일 예시(deploy/compose.yaml). 실제 값은 넣지 않는다.
# 서버에서는 /opt/beone/app/.env로 직접 만들고 권한을 600으로 둔다. Git·이미지·로그에 넣지 않는다.
# 비밀번호는 서버에서 생성한다. 예: openssl rand -hex 24
# 값이 비어 있으면 docker compose가 바로 실패한다.

# 앱 DB 이름과 앱 전용 계정(root 아님). MySQL 첫 기동 때 이 계정이 만들어진다.
MYSQL_DATABASE=beone
MYSQL_USER=beone
MYSQL_PASSWORD=

# MySQL 초기화에만 쓴다. 백엔드에는 넘기지 않는다.
MYSQL_ROOT_PASSWORD=

# docker load로 들여온 이미지 태그. 예: beone-api:<커밋 12자리>
BEONE_API_IMAGE=
