# 기본값은 Vite의 같은 주소 /api 프록시입니다. 별도 데모 API가 필요할 때만 지정합니다.
# VITE_API_BASE_URL=http://localhost:8080

# Vite 개발 서버에서만 적용됩니다. 목 테스트에는 둘 다 mock으로 설정합니다.
VITE_DEVICE_AUTH_MODE=native
VITE_PAYMENT_API_MODE=api
VITE_PAYMENT_MOCK_DELAY_MS=800

# 혜택 조회에는 기본적으로 회원 API를 사용합니다.
# mock은 개발 서버에서만 사용할 수 있습니다.
# VITE_BENEFITS_CONTEXT=demo

# 기본 member는 같은 주소의 인증·업무 API를 사용합니다.
# 시연 백엔드를 연결할 때만 demo를 지정합니다.
# VITE_WORKSPACE_CONTEXT=member
# 주문·결제 설정·모의 승인을 개발용 목에서 함께 실행합니다.
# VITE_PAYMENT_PREFERENCE_MODE=mock
# VITE_PAYMENT_PREFERENCE_MOCK_FAILURE=read
# VITE_PAYMENT_MOCK_PROFILE=fixture

# 카드 추가 목 흐름. 시나리오는 README 카드 추가 절을 참고합니다.
# VITE_ADD_CARD_MODE=mock
# VITE_ADD_CARD_SCENARIO=success
